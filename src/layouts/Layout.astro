---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { SignInButton, UserButton } from '@clerk/astro/components';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = "SomaShiva™ | Ethically Sourced Crystals & Sound Healing",
  description = "Discover hand-selected natural crystals, sacred geometry towers, and meditative singing bowls designed to align your chakras and elevate your daily practice.",
  image = "https://images.unsplash.com/photo-1567225557594-88d73e55f2cb?w=1200",
  canonicalURL = Astro.url.href,
} = Astro.props;

const schemaOrgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Store",
  "name": "SomaShiva™",
  "image": image,
  "description": description,
  "url": canonicalURL,
  "telephone": "+91 9180603108",
  "email": "somashivaofficial@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Electronic City",
    "addressLocality": "Bangalore",
    "addressRegion": "Karnataka",
    "postalCode": "560100",
    "addressCountry": "IN"
  },
  "priceRange": "₹₹"
};

let userId: string | null = null;
try {
  if (Astro.locals && typeof Astro.locals.auth === 'function') {
    userId = Astro.locals.auth().userId || null;
  }
} catch (e) {
  userId = null;
}
---

<!DOCTYPE html>
<html lang="en" class="max-w-[100vw] overflow-x-hidden m-0 p-0 box-border">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- PWA & TWA Manifest & Theme -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#faf6ef" />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:site_name" content="SomaShiva" />
    <meta property="og:title" content="SomaShiva™ | Ethically Sourced Crystals & Sound Healing" />
    <meta property="og:description" content="Authentic, hand-crafted sacred brass idols, consecrated Rudraksha, and spiritual sanctum pieces." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={image} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- JSON-LD Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrgJsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style is:global>
      html, body {
        touch-action: pan-y !important;
        -webkit-overflow-scrolling: touch;
        overflow-x: hidden;
        max-width: 100vw;
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        overscroll-behavior-y: contain;
        -webkit-tap-highlight-color: transparent;
      }
      *, *::before, *::after {
        box-sizing: border-box;
      }

      button, a, [role="button"], span {
        -webkit-user-select: none;
        user-select: none;
      }

      @keyframes universalGradientFlow {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }

      button:not(.decoy-btn),
      [role="button"]:not(.decoy-btn),
      input[type="submit"]:not(.decoy-btn),
      a[class*="bg-"]:not(.decoy-btn),
      nav a:not(.logo-link),
      .btn-gradient-all {
        transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s ease, background-color 0.25s ease, color 0.25s ease !important;
        position: relative;
      }

      button:not(.decoy-btn):hover,
      button:not(.decoy-btn):focus-visible,
      button:not(.decoy-btn):active,
      [role="button"]:not(.decoy-btn):hover,
      [role="button"]:not(.decoy-btn):active,
      input[type="submit"]:not(.decoy-btn):hover,
      a[class*="bg-"]:not(.decoy-btn):hover,
      a[class*="bg-"]:not(.decoy-btn):active,
      nav a:not(.logo-link):hover,
      nav a:not(.logo-link):active,
      .btn-gradient-all:hover {
        background-image: linear-gradient(110deg, #8a6206 0%, #b8860b 25%, #f3e5ab 50%, #d4af37 75%, #8a6206 100%) !important;
        background-size: 250% 250% !important;
        animation: universalGradientFlow 2s linear infinite !important;
        color: #1f160a !important;
        transform: translateY(-2px);
        box-shadow: 0 8px 22px -4px rgba(212, 175, 55, 0.6) !important;
        border-color: rgba(243, 229, 171, 0.75) !important;
        border-radius: 0.5rem;
      }
    </style>
  </head>
  <body class="bg-[#FAF7F2] text-[#4A3B2C] antialiased font-['Outfit',sans-serif] min-h-screen flex flex-col selection:bg-[#E6CA65]/30 selection:text-amber-950">
    <!-- Fixed Bottom-Left WhatsApp Button (Direct Child of Body) -->
    <a
      id="floating-whatsapp-btn"
      href="https://wa.me/919180603108?text=Namaste%20SomaShiva,%20I%20have%20an%20inquiry%20regarding%20your%20sacred%20collection."
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat on WhatsApp"
      class="fixed bottom-6 left-6 z-[999] flex items-center justify-center w-12 h-12 md:w-14 md:h-14 bg-[#25D366] hover:bg-[#20ba5a] text-white rounded-full shadow-[0_0_15px_rgba(37,211,102,0.4)] transition-all duration-300 cursor-pointer hidden opacity-0 pointer-events-none"
      style="position: fixed; bottom: 24px; left: 24px; z-index: 999;"
    >
      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
    </a>

    <!-- Main Content Wrapper with relative z-10 and max-w-full overflow-x-hidden -->
    <div class="relative z-10 flex flex-col min-h-screen w-full max-w-full overflow-x-hidden">
      <!-- Client-Side Security Warning Gate Overlay -->
      <div id="security-warning-overlay" class="fixed inset-0 z-[9999] w-full h-full max-w-full overflow-hidden px-6 bg-[#202124] text-[#e8eaed] flex flex-col items-center justify-center font-sans hidden py-6 pointer-events-none">
        <div class="max-w-xl w-full space-y-6">
          <!-- Warning Icon -->
          <div class="flex items-center space-x-3">
            <svg class="w-10 h-10 text-[#f28b82] flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
            </svg>
            <h1 class="text-2xl font-normal text-white">Your connection is not private</h1>
          </div>

          <!-- Description Body -->
          <p class="text-sm text-[#9aa0a6] leading-relaxed">
            Attackers might be trying to steal your information from my-new-website-lime.vercel.app (for example, passwords, messages, or credit cards).
            <a href="https://support.google.com/chrome?p=sec_err" target="_blank" rel="noopener noreferrer" class="text-[#8ab4f8] hover:underline">Learn more</a>
          </p>

          <!-- Tech Details -->
          <p class="text-xs text-[#5f6368] font-mono">
            NET::ERR_CERT_COMMON_NAME_INVALID
          </p>

          <!-- Buttons -->
          <div class="pt-4 flex items-center space-x-4">
            <a
              href="https://google.com"
              class="decoy-btn bg-[#8ab4f8] text-[#202124] px-5 py-2.5 rounded font-medium text-sm hover:bg-[#9bbef9] transition shadow"
            >
              Back to safety
            </a>
          </div>
        </div>

        <!-- Hidden Gray Box in Bottom-Right Corner -->
        <div
          id="passcode-trigger"
          class="decoy-btn fixed bottom-4 right-4 z-[10000] w-5 h-5 bg-stone-800 border border-stone-700 hover:bg-stone-600 rounded cursor-pointer opacity-70 transition"
          title=""
        ></div>

        <!-- Passcode Modal Overlay -->
        <div
          id="passcode-modal"
          class="fixed inset-0 bg-black/70 backdrop-blur-sm z-[10001] hidden flex items-center justify-center p-4 pointer-events-auto"
        >
          <div class="bg-[#292a2d] border border-stone-700 rounded-2xl p-6 max-w-sm w-full space-y-4 shadow-2xl text-left">
            <h3 class="text-lg font-medium text-white">Enter Access Key</h3>
            <p class="text-xs text-[#9aa0a6]">Authorized access key required to unlock site.</p>
            <form id="passcode-form" class="space-y-3">
              <input
                type="password"
                id="passcode-input"
                required
                placeholder="Access key..."
                class="w-full bg-[#202124] border border-stone-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-[#8ab4f8]"
              />
              <div id="error-msg" class="text-xs text-[#f28b82] hidden">Incorrect access key. Please try again.</div>
              <div class="flex justify-end space-x-3 pt-2">
                <button
                  type="button"
                  id="cancel-btn"
                  class="px-4 py-2 rounded-xl text-xs font-medium text-[#9aa0a6] hover:bg-stone-800 transition"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  class="bg-[#8ab4f8] text-[#202124] px-5 py-2 rounded-xl text-xs font-semibold hover:bg-[#9bbef9] transition"
                >
                  Authenticate
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- Top Announcement Bar -->
      <div class="bg-[#7A5212] text-[#FAF7F2] text-xs font-medium py-2.5 px-4 text-center tracking-wide w-full max-w-full">
        ✨ Free Express Shipping Across India on Direct Orders | 100% Authentic Natural Stones
      </div>

      <!-- Navigation Header -->
      <nav class="bg-[#FAF7F2]/90 backdrop-blur-md border-b border-[#E6CA65]/40 sticky top-0 z-50 w-full max-w-full">
        <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between">
          <a href="/" class="logo-link flex items-center space-x-3 group">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#996515] to-[#D4AF37] flex items-center justify-center shadow-md shadow-amber-900/10 group-hover:scale-105 transition">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            </div>
            <span class="text-xl font-bold tracking-wide font-['Cormorant_Garamond',serif] text-[#7A5212]">SomaShiva™</span>
          </a>

          <!-- Desktop Links & Auth -->
          <div class="hidden md:flex items-center space-x-8 text-sm font-medium">
            <a href="/" class="text-[#7A5212] hover:text-[#D4AF37] transition">Catalog</a>
            <a href="/guide" class="text-[#7A5212] hover:text-[#D4AF37] transition">Cleansing Guide</a>
            <a href="/privacy" class="text-[#7A5212] hover:text-[#D4AF37] transition">Privacy</a>
            <a href="/contact" class="text-[#7A5212] hover:text-[#D4AF37] transition">Contact</a>

            <button type="button" class="open-cart-trigger relative p-2 text-[#7A5212] hover:text-[#D4AF37] transition cursor-pointer flex items-center" aria-label="Open Cart">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
              <span id="cart-count-badge" class="absolute -top-1 -right-1 bg-[#D4AF37] text-white text-[10px] font-bold w-5 h-5 rounded-full flex items-center justify-center shadow-md" style="display: none;">0</span>
            </button>

            {userId ? (
              <UserButton afterSignOutUrl="/" />
            ) : (
              <SignInButton mode="modal">
                <button class="btn-gradient-all bg-[#b8860b] text-white px-4 py-2 rounded-lg text-sm font-medium shadow-sm cursor-pointer" id="clerk-sign-in-btn">
                  Sign in
                </button>
              </SignInButton>
            )}
          </div>

          <!-- Mobile Actions -->
          <div class="flex items-center space-x-2 md:hidden">
            <button type="button" class="open-cart-trigger relative p-2 text-[#7A5212] hover:text-[#D4AF37] transition cursor-pointer flex items-center" aria-label="Open Cart">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
              <span id="cart-count-badge" class="absolute -top-1 -right-1 bg-[#D4AF37] text-white text-[10px] font-bold w-5 h-5 rounded-full flex items-center justify-center shadow-md" style="display: none;">0</span>
            </button>
            <button id="menu-btn" aria-label="Toggle Navigation Menu" class="p-2 text-[#7A5212] focus:outline-none">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </button>
          </div>
        </div>

        <!-- Mobile Drawer Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-[#FAF7F2] border-b border-[#E6CA65]/40 px-6 py-4 space-y-4 shadow-lg w-full max-w-full">
          <a href="/" class="block text-sm font-medium text-[#7A5212]">Catalog</a>
          <a href="/guide" class="block text-sm font-medium text-[#7A5212]">Cleansing Guide</a>
          <a href="/privacy" class="block text-sm font-medium text-[#7A5212]">Privacy</a>
          <a href="/contact" class="block text-sm font-medium text-[#7A5212]">Contact</a>
          <div class="pt-2 border-t border-[#E6CA65]/40 flex items-center justify-between">
            <button type="button" class="open-cart-trigger text-xs font-semibold text-[#7A5212] flex items-center space-x-1.5 py-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
              <span>View Cart</span>
            </button>
            {userId ? (
              <UserButton afterSignOutUrl="/" />
            ) : (
              <SignInButton mode="modal">
                <button class="btn-gradient-all bg-[#b8860b] text-white px-4 py-2 rounded-lg text-sm font-medium shadow-sm cursor-pointer" id="clerk-sign-in-btn-mobile">
                  Sign in
                </button>
              </SignInButton>
            )}
          </div>
        </div>
      </nav>

      <main class="flex-grow w-full max-w-full overflow-x-hidden">
        <slot />
      </main>

      <!-- Footer Component -->
      <Footer />
    </div>

    <Analytics />

    <script>
      // Service Worker Registration
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }

      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
        });
      }

      // Context-aware WhatsApp floating button linkage
      const waBtn = document.getElementById('floating-whatsapp-btn') as HTMLAnchorElement;
      if (waBtn) {
        const path = window.location.pathname;
        if (path.startsWith('/product/')) {
          const titleEl = document.querySelector('h1');
          const prodName = titleEl ? titleEl.textContent?.trim() : 'this sacred artifact';
          waBtn.href = `https://wa.me/919180603108?text=${encodeURIComponent(`Namaste SomaShiva, I have an inquiry regarding ${prodName}.`)}`;
        } else {
          try {
            const cart = localStorage.getItem('somashiva_cart');
            const items = cart ? JSON.parse(cart) : [];
            if (items.length > 0) {
              waBtn.href = `https://wa.me/919180603108?text=${encodeURIComponent('Namaste SomaShiva, I have an inquiry regarding the items in my cart.')}`;
            } else {
              waBtn.href = `https://wa.me/919180603108?text=${encodeURIComponent('Namaste SomaShiva, I have an inquiry regarding your sacred collection.')}`;
            }
          } catch {
            waBtn.href = `https://wa.me/919180603108?text=${encodeURIComponent('Namaste SomaShiva, I have an inquiry regarding your sacred collection.')}`;
          }
        }
      }

      // Clerk Sign-In Direct Handler
      const signInBtn = document.getElementById('clerk-sign-in-btn');
      if (signInBtn) {
        signInBtn.addEventListener('click', () => {
          if (window.Clerk && typeof window.Clerk.openSignIn === 'function') {
            window.Clerk.openSignIn();
          }
        });
      }
      const signInBtnMobile = document.getElementById('clerk-sign-in-btn-mobile');
      if (signInBtnMobile) {
        signInBtnMobile.addEventListener('click', () => {
          if (window.Clerk && typeof window.Clerk.openSignIn === 'function') {
            window.Clerk.openSignIn();
          }
        });
      }

      // Security Warning Overlay & Passcode Logic
      const overlay = document.getElementById('security-warning-overlay');
      const trigger = document.getElementById('passcode-trigger');
      const modal = document.getElementById('passcode-modal');
      const cancelBtn = document.getElementById('cancel-btn');
      const form = document.getElementById('passcode-form') as HTMLFormElement;
      const input = document.getElementById('passcode-input') as HTMLInputElement;
      const errorMsg = document.getElementById('error-msg');
      const whatsappBtn = document.getElementById('floating-whatsapp-btn');

      function checkAccess() {
        if (!document.cookie.includes('somashiva_access=granted')) {
          overlay?.classList.remove('hidden');
          overlay?.classList.remove('pointer-events-none');
          whatsappBtn?.classList.add('hidden', 'opacity-0', 'pointer-events-none');
          whatsappBtn?.classList.remove('opacity-100', 'pointer-events-auto');
        } else {
          overlay?.classList.add('hidden');
          overlay?.classList.add('pointer-events-none');
          whatsappBtn?.classList.remove('hidden');
          setTimeout(() => {
            whatsappBtn?.classList.remove('opacity-0', 'pointer-events-none');
            whatsappBtn?.classList.add('opacity-100', 'pointer-events-auto');
          }, 50);
        }
      }

      checkAccess();

      trigger?.addEventListener('click', () => {
        modal?.classList.remove('hidden');
        input?.focus();
      });

      cancelBtn?.addEventListener('click', () => {
        modal?.classList.add('hidden');
        if (input) input.value = '';
        errorMsg?.classList.add('hidden');
      });

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const val = input?.value.trim();

        if (val === 'somashiva2026') {
          document.cookie = 'somashiva_access=granted; path=/; max-age=2592000; SameSite=Lax';
          modal?.classList.add('hidden');
          overlay?.classList.add('hidden');
          overlay?.classList.add('pointer-events-none');
          whatsappBtn?.classList.remove('hidden');
          setTimeout(() => {
            whatsappBtn?.classList.remove('opacity-0', 'pointer-events-none');
            whatsappBtn?.classList.add('opacity-100', 'pointer-events-auto');
          }, 50);
          if (input) input.value = '';
          errorMsg?.classList.add('hidden');
        } else {
          errorMsg?.classList.remove('hidden');
          if (input) {
            input.value = '';
            input.focus();
          }
        }
      });
    </script>
    <CartDrawer />
  </body>
</html>
