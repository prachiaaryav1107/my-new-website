---
---
<!-- Cart Drawer Backdrop -->
<div id="cart-backdrop" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-[80] hidden transition-opacity opacity-0"></div>

<!-- Slide-out Cart Drawer -->
<div id="cart-drawer" class="fixed top-0 right-0 h-full w-full max-w-md bg-[#FAF7F2] shadow-2xl z-[90] transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col border-l border-[#E6CA65]/60">
  <!-- Header -->
  <div class="p-6 border-b border-[#E6CA65]/40 flex items-center justify-between bg-white">
    <div class="flex items-center space-x-2">
      <div class="w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center text-[#996515]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
      </div>
      <h2 class="font-['Cormorant_Garamond',serif] text-xl font-bold text-[#7A5212]">Your Sacred Cart</h2>
    </div>
    <button id="close-cart-btn" aria-label="Close Cart" class="p-2 text-[#7A5212] hover:bg-amber-50 rounded-xl transition cursor-pointer">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>

  <!-- Free Shipping Banner -->
  <div class="bg-amber-50 border-b border-[#E6CA65]/40 px-6 py-2.5 text-center text-xs text-[#996515] font-medium">
    ✨ Free Express Sacred Shipping Across India on All Orders
  </div>

  <!-- Cart Items List -->
  <div id="cart-items-list" class="flex-grow overflow-y-auto p-6 space-y-4">
    <!-- Populated via JS -->
  </div>

  <!-- Footer / Checkout -->
  <div id="cart-footer-section" class="p-6 bg-white border-t border-[#E6CA65]/40 space-y-4">
    <div class="flex justify-between items-center text-sm">
      <span class="text-[#4A3B2C] font-medium">Subtotal</span>
      <span id="cart-subtotal" class="font-extrabold text-xl text-[#7A5212]">₹0</span>
    </div>
    <button
      id="open-checkout-modal-btn"
      class="btn-gradient-all w-full bg-[#996515] hover:bg-[#7A5212] text-white font-semibold py-4 rounded-2xl shadow-sm transition text-center cursor-pointer block"
    >
      Proceed to Sacred Checkout
    </button>
    <div class="flex flex-col space-y-1.5 text-center">
      <p class="text-[11px] text-[#8B5E14]/80">⚡ Airway Bill & live tracking updates dispatched directly via WhatsApp.</p>
      <a href="https://wa.me/919080603108?text=Namaste%20Somashiva,%20I%20have%20an%20inquiry%20regarding%20the%20sacred%20artifacts%20in%20my%20cart." target="_blank" rel="noopener noreferrer" class="text-[11px] text-[#996515] hover:text-[#7A5212] underline decoration-[#E6CA65] font-medium transition">
        Need guidance? Inquire about this cart on WhatsApp
      </a>
    </div>
  </div>
</div>

<!-- Checkout Modal -->
<div id="checkout-modal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-[100] hidden flex items-center justify-center p-4">
  <div class="bg-white border border-[#E6CA65]/60 rounded-3xl p-8 max-w-lg w-full space-y-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center border-b border-[#E6CA65]/40 pb-4">
      <h3 class="text-2xl font-bold font-['Cormorant_Garamond',serif] text-[#7A5212]">Sacred Order Checkout</h3>
      <button id="close-checkout-modal" class="text-[#7A5212] hover:text-amber-900 p-1 rounded-lg">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- Order Summary Review -->
    <div id="checkout-order-review" class="bg-[#FAF7F2] border border-[#E6CA65]/40 rounded-2xl p-4 space-y-2">
      <h4 class="text-xs font-bold uppercase tracking-wider text-[#8B5E14]">Order Summary</h4>
      <div id="checkout-line-items" class="space-y-1 text-xs text-[#4A3B2C]">
        <!-- Line items populated via JS -->
      </div>
      <div class="border-t border-[#E6CA65]/40 pt-2 flex justify-between font-bold text-sm text-[#7A5212]">
        <span>Total Amount</span>
        <span id="checkout-modal-total">₹0</span>
      </div>
    </div>

    <!-- Success Screen State (Elegant Post-Purchase Celebration View) -->
    <div id="order-success-screen" class="hidden text-center py-6 space-y-5">
      <div class="w-20 h-20 bg-amber-50 rounded-full flex items-center justify-center mx-auto text-[#D4AF37] border border-[#E6CA65] shadow-lg">
        <!-- Golden Trishul / check emblem -->
        <svg class="w-10 h-10 animate-pulse text-[#996515]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      </div>
      <h4 class="text-2xl font-bold font-['Cormorant_Garamond',serif] text-[#7A5212]">Order Registered with Reverence</h4>
      <div class="bg-[#FAF7F2] border border-[#E6CA65]/60 rounded-2xl p-4 space-y-2">
        <p class="text-xs text-[#4A3B2C]">Unique Order Reference:</p>
        <p id="success-order-id" class="text-xl font-extrabold font-mono text-[#996515] tracking-wider"></p>
        <p class="text-xs text-[#8B5E14] font-light pt-1">An itemized receipt has been dispatched to your email and AWB tracking will follow on WhatsApp upon UPI verification.</p>
      </div>
      <div class="pt-2">
        <a id="success-whatsapp-link" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-[#25D366] hover:bg-[#20ba5a] text-white font-semibold py-3.5 px-6 rounded-2xl text-xs shadow-md transition space-x-2 w-full">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          <span>Complete UPI Verification on WhatsApp</span>
        </a>
      </div>
    </div>

    <!-- Checkout Form -->
    <form id="checkout-form" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-[#8B5E14] uppercase tracking-wider mb-1">Full Name</label>
        <input type="text" id="cust-name" required placeholder="e.g. Priya Sharma" class="w-full bg-[#FAF7F2] border border-[#E6CA65]/60 rounded-xl px-4 py-3 text-sm text-[#4A3B2C] focus:outline-none focus:border-[#996515]" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-[#8B5E14] uppercase tracking-wider mb-1">Email Address (For Bill & Tax Invoice)</label>
        <input type="email" id="cust-email" required placeholder="e.g. priya@example.com" class="w-full bg-[#FAF7F2] border border-[#E6CA65]/60 rounded-xl px-4 py-3 text-sm text-[#4A3B2C] focus:outline-none focus:border-[#996515]" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-[#8B5E14] uppercase tracking-wider mb-1">WhatsApp / Phone Number (10 Digits)</label>
        <input type="tel" id="cust-phone" required pattern="[0-9]{10}" maxlength="10" title="Please enter a valid 10-digit Indian phone number" placeholder="e.g. 9876543210" class="w-full bg-[#FAF7F2] border border-[#E6CA65]/60 rounded-xl px-4 py-3 text-sm text-[#4A3B2C] focus:outline-none focus:border-[#996515]" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-[#8B5E14] uppercase tracking-wider mb-1">Delivery Address</label>
        <textarea id="cust-address" required rows="2" placeholder="Street address, apartment, landmark..." class="w-full bg-[#FAF7F2] border border-[#E6CA65]/60 rounded-xl px-4 py-3 text-sm text-[#4A3B2C] focus:outline-none focus:border-[#996515]"></textarea>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-[#8B5E14] uppercase tracking-wider mb-1">City</label>
          <input type="text" id="cust-city" required placeholder="e.g. Bengaluru" class="w-full bg-[#FAF7F2] border border-[#E6CA65]/60 rounded-xl px-4 py-3 text-sm text-[#4A3B2C] focus:outline-none focus:border-[#996515]" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-[#8B5E14] uppercase tracking-wider mb-1">Pincode (6 Digits)</label>
          <input type="text" id="cust-pincode" required pattern="[0-9]{6}" maxlength="6" title="Please enter a valid 6-digit Indian pincode" placeholder="e.g. 560100" class="w-full bg-[#FAF7F2] border border-[#E6CA65]/60 rounded-xl px-4 py-3 text-sm text-[#4A3B2C] focus:outline-none focus:border-[#996515]" />
        </div>
      </div>

      <div class="pt-2 space-y-3">
        <!-- 100% Prepaid Sanctum Policy Badge -->
        <div class="bg-amber-50 border border-[#E6CA65] rounded-2xl p-4 text-xs text-[#7A5212] space-y-1.5 shadow-sm">
          <div class="font-bold flex items-center space-x-1.5">
            <svg class="w-4 h-4 text-[#996515] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            <span>🔒 100% Prepaid Sanctum Policy</span>
          </div>
          <p class="text-[11px] text-[#4A3B2C] leading-relaxed font-light">
            We operate exclusively on prepaid orders (UPI / Bank Transfer). Once registered, our team verifies payment via WhatsApp and dispatches your Airway Bill (AWB) & live tracking link.
          </p>
        </div>

        <button
          type="submit"
          id="place-sacred-order-btn"
          class="btn-gradient-all w-full bg-[#996515] hover:bg-[#7A5212] text-white font-semibold py-4 rounded-2xl shadow-sm transition text-center cursor-pointer block text-sm flex items-center justify-center space-x-2"
        >
          <span>Register Order & Proceed to UPI Verification →</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  interface CartItem {
    id: string;
    name: string;
    price: number;
    image: string;
    quantity: number;
  }

  const getCart = (): CartItem[] => {
    try {
      const stored = localStorage.getItem('somashiva_cart');
      return stored ? JSON.parse(stored) : [];
    } catch {
      return [];
    }
  };

  const saveCart = (cart: CartItem[]) => {
    try {
      localStorage.setItem('somashiva_cart', JSON.stringify(cart));
      updateCartUI();
    } catch {}
  };

  declare global {
    interface Window {
      addToCart: (product: { id: string; name: string; price: number; image: string }) => void;
      toggleCart: () => void;
      openCart: () => void;
      updateQty: (id: string, qty: number) => void;
      removeItem: (id: string) => void;
    }
  }

  window.addToCart = (product) => {
    const cart = getCart();
    const existing = cart.find(i => i.id === product.id);
    if (existing) {
      existing.quantity += 1;
    } else {
      cart.push({ ...product, quantity: 1 });
    }
    saveCart(cart);
    window.openCart();
  };

  window.toggleCart = () => {
    const drawer = document.getElementById('cart-drawer');
    const backdrop = document.getElementById('cart-backdrop');
    if (drawer && backdrop) {
      const isOpen = !drawer.classList.contains('translate-x-full');
      if (isOpen) {
        drawer.classList.add('translate-x-full');
        backdrop.classList.add('opacity-0', 'hidden');
      } else {
        drawer.classList.remove('translate-x-full');
        backdrop.classList.remove('hidden');
        setTimeout(() => backdrop.classList.remove('opacity-0'), 10);
        updateCartUI();
      }
    }
  };

  window.openCart = () => {
    const drawer = document.getElementById('cart-drawer');
    const backdrop = document.getElementById('cart-backdrop');
    if (drawer && backdrop) {
      drawer.classList.remove('translate-x-full');
      backdrop.classList.remove('hidden');
      setTimeout(() => backdrop.classList.remove('opacity-0'), 10);
      updateCartUI();
    }
  };

  const updateCartUI = () => {
    const cart = getCart();
    const container = document.getElementById('cart-items-list');
    const badge = document.getElementById('cart-count-badge');
    const subtotalEl = document.getElementById('cart-subtotal');
    const footerSection = document.getElementById('cart-footer-section');

    const totalCount = cart.reduce((sum, i) => sum + i.quantity, 0);
    const subtotal = cart.reduce((sum, i) => sum + i.price * i.quantity, 0);

    if (badge) {
      badge.textContent = totalCount.toString();
      badge.style.display = totalCount > 0 ? 'flex' : 'none';
    }

    if (subtotalEl) {
      subtotalEl.textContent = `₹${subtotal}`;
    }

    if (container) {
      if (cart.length === 0) {
        if (footerSection) footerSection.style.display = 'none';
        container.innerHTML = `
          <div class="text-center py-16 space-y-6">
            <div class="w-20 h-20 bg-amber-50 rounded-full flex items-center justify-center mx-auto text-[#996515] border border-[#E6CA65]/60 shadow-sm">
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
            </div>
            <p class="text-sm font-medium text-[#7A5212] px-6 leading-relaxed">Your sacred cart is empty. Begin your spiritual journey with our consecrated collection.</p>
            <a href="/#catalog" onclick="window.toggleCart()" class="inline-block bg-[#996515] text-white text-xs font-semibold px-6 py-3.5 rounded-2xl shadow hover:bg-[#7A5212] transition">
              Explore Sacred Offerings
            </a>
          </div>
        `;
      } else {
        if (footerSection) footerSection.style.display = 'block';
        container.innerHTML = cart.map(item => `
          <div class="flex items-center space-x-4 bg-white border border-[#E6CA65]/60 p-4 rounded-2xl shadow-sm">
            <img src="${item.image}" alt="${item.name}" class="w-16 h-16 object-cover rounded-xl border border-[#E6CA65]/40" />
            <div class="flex-grow">
              <h4 class="text-xs font-bold text-[#7A5212] font-['Cormorant_Garamond',serif] line-clamp-1">${item.name}</h4>
              <span class="text-xs font-extrabold text-[#996515]">₹${item.price}</span>
              <div class="flex items-center space-x-3 mt-2">
                <button type="button" onclick="window.updateQty('${item.id}', ${item.quantity - 1})" class="w-6 h-6 bg-[#FAF7F2] border border-[#E6CA65] rounded-lg text-xs font-bold text-[#7A5212] hover:bg-amber-50">-</button>
                <span class="text-xs font-semibold text-[#4A3B2C]">${item.quantity}</span>
                <button type="button" onclick="window.updateQty('${item.id}', ${item.quantity + 1})" class="w-6 h-6 bg-[#FAF7F2] border border-[#E6CA65] rounded-lg text-xs font-bold text-[#7A5212] hover:bg-amber-50">+</button>
              </div>
            </div>
            <button type="button" onclick="window.removeItem('${item.id}')" class="text-stone-400 hover:text-red-500 p-2 transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </button>
          </div>
        `).join('');
      }
    }
  };

  window.updateQty = (id, qty) => {
    let cart = getCart();
    if (qty <= 0) {
      cart = cart.filter(i => i.id !== id);
    } else {
      const item = cart.find(i => i.id === id);
      if (item) item.quantity = qty;
    }
    saveCart(cart);
  };

  window.removeItem = (id) => {
    const cart = getCart().filter(i => i.id !== id);
    saveCart(cart);
  };

  document.getElementById('close-cart-btn')?.addEventListener('click', window.toggleCart);
  document.getElementById('cart-backdrop')?.addEventListener('click', window.toggleCart);

  document.querySelectorAll('.open-cart-trigger').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const cart = getCart();
      if (cart.length === 0) {
        window.location.href = '/#catalog';
        return;
      }
      window.openCart();
    });
  });

  // Strict input sanitization for phone and pincode
  const phoneInputEl = document.getElementById('cust-phone') as HTMLInputElement;
  const pincodeInputEl = document.getElementById('cust-pincode') as HTMLInputElement;

  phoneInputEl?.addEventListener('input', () => {
    phoneInputEl.value = phoneInputEl.value.replace(/\D/g, '').slice(0, 10);
  });

  pincodeInputEl?.addEventListener('input', () => {
    pincodeInputEl.value = pincodeInputEl.value.replace(/\D/g, '').slice(0, 6);
  });

  const checkoutModal = document.getElementById('checkout-modal');
  const openCheckoutBtn = document.getElementById('open-checkout-modal-btn');
  const closeCheckoutBtn = document.getElementById('close-checkout-modal');
  const checkoutForm = document.getElementById('checkout-form') as HTMLFormElement;
  const orderSuccessScreen = document.getElementById('order-success-screen');
  const checkoutOrderReview = document.getElementById('checkout-order-review');

  openCheckoutBtn?.addEventListener('click', () => {
    const cart = getCart();
    if (cart.length === 0) {
      alert('Your cart is empty.');
      return;
    }
    window.toggleCart();
    
    // Populate review summary
    const lineItemsContainer = document.getElementById('checkout-line-items');
    const modalTotal = document.getElementById('checkout-modal-total');
    const subtotal = cart.reduce((sum, i) => sum + i.price * i.quantity, 0);

    if (lineItemsContainer) {
      lineItemsContainer.innerHTML = cart.map(i => `
        <div class="flex justify-between">
          <span>${i.name} (×${i.quantity})</span>
          <span class="font-semibold">₹${i.price * i.quantity}</span>
        </div>
      `).join('');
    }
    if (modalTotal) {
      modalTotal.textContent = `₹${subtotal}`;
    }

    checkoutForm?.classList.remove('hidden');
    orderSuccessScreen?.classList.add('hidden');
    checkoutOrderReview?.classList.remove('hidden');
    checkoutModal?.classList.remove('hidden');
  });

  closeCheckoutBtn?.addEventListener('click', () => {
    checkoutModal?.classList.add('hidden');
  });

  checkoutForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const cart = getCart();
    const name = (document.getElementById('cust-name') as HTMLInputElement).value;
    const email = (document.getElementById('cust-email') as HTMLInputElement).value;
    const phoneInput = (document.getElementById('cust-phone') as HTMLInputElement).value;
    const phone = phoneInput.replace(/\D/g, '').slice(-10);
    const address = (document.getElementById('cust-address') as HTMLTextAreaElement).value;
    const city = (document.getElementById('cust-city') as HTMLInputElement).value;
    const pincode = (document.getElementById('cust-pincode') as HTMLInputElement).value;
    const subtotal = cart.reduce((sum, i) => sum + i.price * i.quantity, 0);

    const submitBtn = document.getElementById('place-sacred-order-btn') as HTMLButtonElement;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Sanctifying & Registering Order...</span>
      `;
    }

    try {
      const res = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          customerName: name,
          customerEmail: email,
          customerPhone: phone,
          address,
          city,
          pincode,
          cartItems: cart,
          cartTotal: subtotal
        })
      });

      const data = await res.json();
      const orderId = data.orderId || `SS-${Math.floor(100000 + Math.random() * 900000)}`;

      // WhatsApp tracking link
      const waMsg = encodeURIComponent(
        `Namaste Somashiva, I just registered order ${orderId} (₹${subtotal}). Please share UPI verification details.`
      );
      const waLink = `https://wa.me/919080603108?text=${waMsg}`;
      const successWaBtn = document.getElementById('success-whatsapp-link') as HTMLAnchorElement;
      if (successWaBtn) successWaBtn.href = waLink;

      const successOrderIdSpan = document.getElementById('success-order-id');
      if (successOrderIdSpan) successOrderIdSpan.textContent = `#${orderId}`;

      // Show success screen
      checkoutForm.classList.add('hidden');
      checkoutOrderReview?.classList.add('hidden');
      orderSuccessScreen?.classList.remove('hidden');

      // Clear cart
      localStorage.removeItem('somashiva_cart');
      updateCartUI();
    } catch (err) {
      alert('Order submission failed. Please try again or contact support.');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>Register Order & Proceed to UPI Verification →</span>';
      }
    }
  });

  updateCartUI();
</script>
