---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';
---

<Layout title="Brand Showcase & Catalog">
  <section class="py-16 text-center bg-white border-b border-gray-200">
    <div class="max-w-3xl mx-auto px-4">
      <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
        Premium Stationery & Magnets
      </h1>
      <p class="mt-4 text-lg text-gray-600">
        Direct from factory precision crafting. Available on Amazon and direct checkout.
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold mb-8">Featured Collection</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {products.map((item) => (
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition">
          <img src={item.image} alt={item.name} class="w-full h-48 object-cover" />
          <div class="p-6">
            <span class="text-xs font-semibold text-indigo-600 uppercase tracking-wider">{item.category}</span>
            <h3 class="text-lg font-bold text-gray-900 mt-1">{item.name}</h3>
            <p class="text-gray-600 text-sm mt-2 line-clamp-2">{item.description}</p>
            <div class="mt-4 flex items-center justify-between">
              <span class="text-xl font-bold">₹{item.price}</span>
              <a href={`/product/${item.id}`} class="bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700">
                View Details
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
