---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';

const categories = ["All", ...Array.from(new Set(products.map(p => p.category)))];
---

<Layout title="SomaShiva™ | High Vibrational Sacred Tools">
  <!-- Hero Banner -->
  <section class="relative py-24 overflow-hidden bg-[#F5F0E8] border-b border-[#E6CA65]/40">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#E6CA65]/20 via-transparent to-transparent pointer-events-none"></div>
    <div class="max-w-4xl mx-auto px-6 text-center relative z-10">
      <span class="inline-block py-1.5 px-5 rounded-full bg-amber-50 border border-[#E6CA65] text-[#B8860B] text-xs font-semibold tracking-widest uppercase mb-6 shadow-sm">
        Ethically Sourced Crystals & Sound Healing
      </span>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight font-['Cormorant_Garamond',serif] text-[#7A5212] mb-6 leading-tight">
        Elevate Your Space & <span class="text-[#996515] italic">Inner Energy</span>
      </h1>
      <p class="text-lg sm:text-xl text-[#4A3B2C] max-w-2xl mx-auto leading-relaxed mb-10 font-light">
        Discover hand-selected natural crystals, sacred geometry towers, and meditative instruments designed to align your chakras and elevate your daily practice.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="#catalog" class="bg-[#996515] hover:bg-[#7A5212] text-white font-semibold px-8 py-4 rounded-2xl shadow-sm transition transform hover:-translate-y-0.5">
          Explore Sacred Catalog
        </a>
        <a href="/guide" class="bg-white hover:bg-amber-50 border border-[#E6CA65] text-[#7A5212] font-semibold px-8 py-4 rounded-2xl shadow-sm transition">
          View Cleansing Guide
        </a>
      </div>
    </div>
  </section>

  <!-- Catalog Section -->
  <section id="catalog" class="max-w-7xl mx-auto px-6 py-20">
    <div class="flex flex-col md:flex-row justify-between items-center mb-12">
      <div>
        <h2 class="text-3xl font-extrabold font-['Cormorant_Garamond',serif] text-[#996515] tracking-tight">Sacred Collection</h2>
        <p class="text-[#4A3B2C] text-sm mt-1">Select a crystal to view energetic properties and checkout options</p>
      </div>

      <!-- Category Filter Buttons -->
      <div class="flex flex-wrap gap-2 mt-6 md:mt-0" id="filter-container">
        {categories.map((cat, index) => (
          <button
            class={`category-btn px-4 py-2 rounded-xl text-xs font-semibold transition ${index === 0 ? 'bg-[#996515] text-white shadow-sm' : 'bg-white border border-[#E6CA65] text-[#7A5212] hover:bg-amber-50'}`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8" id="product-grid">
      {products.map((item) => (
        <div
          class="product-card bg-white border border-[#E6CA65]/60 rounded-3xl overflow-hidden hover:border-[#996515] hover:shadow-xl transition-all duration-300 flex flex-col group shadow-sm"
          data-category={item.category}
        >
          <div class="relative overflow-hidden aspect-square bg-[#FAF7F2]">
            <img src={item.image} alt={item.name} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
            <div class="absolute top-3 left-3">
              <span class="bg-amber-50/90 backdrop-blur-md border border-[#E6CA65] text-[#B8860B] px-3 py-1 rounded-full text-xs font-semibold shadow-sm">
                {item.chakra}
              </span>
            </div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs font-semibold text-[#B8860B] uppercase tracking-widest mb-1">{item.category}</span>
            <h3 class="text-lg font-bold font-['Cormorant_Garamond',serif] text-[#8B5E14] mb-2 line-clamp-1">{item.name}</h3>
            <p class="text-[#4A3B2C] text-xs mb-4 line-clamp-2 leading-relaxed">{item.description}</p>
            
            <div class="mt-auto pt-4 border-t border-[#E6CA65]/40 flex items-center justify-between">
              <div>
                <span class="text-xs text-[#8B5E14] block">Investment</span>
                <span class="text-xl font-extrabold text-[#7A5212]">₹{item.price}</span>
              </div>
              <a
                href={`/product/${item.id}`}
                class="bg-amber-50 hover:bg-amber-100 border border-[#E6CA65] text-[#7A5212] px-4 py-2.5 rounded-xl text-xs font-bold transition flex items-center space-x-1"
              >
                <span>View Sacred Details</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll('.category-btn');
    const cards = document.querySelectorAll('.product-card');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => {
          b.classList.remove('bg-[#996515]', 'text-white', 'shadow-sm');
          b.classList.add('bg-white', 'border', 'border-[#E6CA65]', 'text-[#7A5212]', 'hover:bg-amber-50');
        });
        btn.classList.add('bg-[#996515]', 'text-white', 'shadow-sm');
        btn.classList.remove('bg-white', 'border', 'border-[#E6CA65]', 'text-[#7A5212]', 'hover:bg-amber-50');

        const selectedCat = btn.getAttribute('data-category');

        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (selectedCat === 'All' || cardCat === selectedCat) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>
