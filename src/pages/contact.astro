---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us | Somashiva™">
  <div class="max-w-5xl mx-auto px-6 py-16">
    <div class="text-center mb-16">
      <span class="inline-block py-1.5 px-5 rounded-full bg-amber-50 border border-[#E6CA65] text-[#B8860B] text-xs font-semibold tracking-widest uppercase mb-4 shadow-sm">Get in Touch</span>
      <h1 class="text-4xl md:text-5xl font-extrabold font-['Cormorant_Garamond',serif] text-[#7A5212] mt-2 mb-4 tracking-tight">Contact Somashiva™</h1>
      <p class="text-[#4A3B2C] text-lg max-w-2xl mx-auto leading-relaxed font-light">
        Have questions about crystal selection, order tracking, or energetic cleansing? Our sacred support team is here for you.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
      <!-- Contact Info Cards -->
      <div class="space-y-6 lg:col-span-1">
        <div class="bg-white border border-[#E6CA65]/60 rounded-3xl p-6 shadow-sm space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-50 border border-[#E6CA65] flex items-center justify-center text-[#996515]">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-lg font-bold font-['Cormorant_Garamond',serif] text-[#7A5212]">Email Support</h3>
          <p class="text-sm text-[#4A3B2C] font-light">somashivaofficial@gmail.com</p>
        </div>

        <div class="bg-white border border-[#E6CA65]/60 rounded-3xl p-6 shadow-sm space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-50 border border-[#E6CA65] flex items-center justify-center text-[#996515]">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          </div>
          <h3 class="text-lg font-bold font-['Cormorant_Garamond',serif] text-[#7A5212]">WhatsApp & Phone Concierge</h3>
          <p class="text-sm text-[#4A3B2C] font-light mb-2">+91 9080603108</p>
          <a
            href="https://wa.me/message/FXEWJGD7EILID1"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center text-xs font-semibold text-green-700 hover:text-green-800 transition"
          >
            <span>Chat on WhatsApp →</span>
          </a>
        </div>

        <div class="bg-white border border-[#E6CA65]/60 rounded-3xl p-6 shadow-sm space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-50 border border-[#E6CA65] flex items-center justify-center text-[#996515]">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          </div>
          <h3 class="text-lg font-bold font-['Cormorant_Garamond',serif] text-[#7A5212]">Our Office / Workshop</h3>
          <p class="text-sm text-[#4A3B2C] font-light leading-relaxed">
            Somashiva<br />
            Electronic City, Bangalore, Karnataka - 560100, India
          </p>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="bg-white border border-[#E6CA65]/60 rounded-3xl p-8 sm:p-10 shadow-sm lg:col-span-2">
        <h3 class="text-2xl font-bold font-['Cormorant_Garamond',serif] text-[#996515] mb-6">Send Us a Message</h3>
        <form class="space-y-6" onsubmit="event.preventDefault(); alert('Thank you for reaching out. Our sacred concierge will respond within 24 hours.');">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#8B5E14] mb-2">Your Name</label>
              <input type="text" required class="w-full bg-[#FAF7F2] border border-[#E6CA65]/60 rounded-xl px-4 py-3 text-sm text-[#4A3B2C] focus:outline-none focus:border-[#996515]" placeholder="Aarav Sharma" />
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#8B5E14] mb-2">Email Address</label>
              <input type="email" required class="w-full bg-[#FAF7F2] border border-[#E6CA65]/60 rounded-xl px-4 py-3 text-sm text-[#4A3B2C] focus:outline-none focus:border-[#996515]" placeholder="aarav@example.com" />
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[#8B5E14] mb-2">Subject / Inquiry</label>
            <input type="text" required class="w-full bg-[#FAF7F2] border border-[#E6CA65]/60 rounded-xl px-4 py-3 text-sm text-[#4A3B2C] focus:outline-none focus:border-[#996515]" placeholder="Order status / Crystal consultation" />
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[#8B5E14] mb-2">Message</label>
            <textarea rows="4" required class="w-full bg-[#FAF7F2] border border-[#E6CA65]/60 rounded-xl px-4 py-3 text-sm text-[#4A3B2C] focus:outline-none focus:border-[#996515]" placeholder="Write your message here..."></textarea>
          </div>
          <button type="submit" class="w-full bg-[#996515] hover:bg-[#7A5212] text-white font-semibold py-4 rounded-xl shadow-sm transition">
            Send Message
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>
