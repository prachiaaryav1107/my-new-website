---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Spiritual Path Not Found | SomaShiva™">
  <div class="max-w-2xl mx-auto px-6 py-28 text-center space-y-8">
    <div class="w-20 h-20 rounded-2xl bg-amber-50 border border-[#E6CA65] flex items-center justify-center text-[#996515] mx-auto shadow-sm">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
    </div>
    
    <div class="space-y-3">
      <span class="inline-block py-1.5 px-5 rounded-full bg-amber-50 border border-[#E6CA65] text-[#B8860B] text-xs font-semibold tracking-widest uppercase shadow-sm">404 Error</span>
      <h1 class="text-4xl md:text-5xl font-extrabold font-['Cormorant_Garamond',serif] text-[#7A5212] tracking-tight">Spiritual Path Not Found</h1>
      <p class="text-[#4A3B2C] text-lg font-light leading-relaxed max-w-lg mx-auto">
        The energetic pathway or page you are looking for may have shifted frequencies or no longer exists.
      </p>
    </div>

    <div>
      <a href="/" class="inline-flex items-center justify-center bg-[#996515] hover:bg-[#7A5212] text-white font-semibold px-8 py-4 rounded-2xl shadow-sm transition">
        Return to Sacred Catalog
      </a>
    </div>
  </div>
</Layout>
