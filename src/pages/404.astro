---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Sacred Sanctum Uncharted | SomaShiva™" description="The path or artifact you seek lies beyond this sanctum.">
  <div class="max-w-2xl mx-auto px-6 py-24 text-center text-[#4A3B2C]">
    <div class="bg-white border border-[#E6CA65]/60 rounded-3xl p-12 shadow-2xl space-y-6">
      <div class="w-20 h-20 bg-amber-50 rounded-full flex items-center justify-center mx-auto text-[#996515] border border-[#E6CA65]/60 shadow-inner">
        <svg class="w-10 h-10 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
      </div>

      <span class="text-xs font-semibold text-[#B8860B] uppercase tracking-widest">SomaShiva Sanctum</span>
      <h1 class="text-4xl sm:text-6xl font-bold font-['Cormorant_Garamond',serif] text-[#7A5212]">404 — Sacred Sanctum Uncharted</h1>
      <p class="text-sm sm:text-base text-[#4A3B2C] font-light leading-relaxed">
        The path or artifact you seek lies beyond this sanctum. Return to the sacred catalog to continue your spiritual journey.
      </p>

      <div class="pt-4">
        <a href="/" class="btn-gradient-all inline-block bg-[#996515] hover:bg-[#7A5212] text-white font-semibold py-3.5 px-8 rounded-2xl text-xs uppercase tracking-wider transition shadow-lg">
          Return to Sacred Store
        </a>
      </div>
    </div>
  </div>
</Layout>
