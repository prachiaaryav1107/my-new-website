---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy | Somashiva Sacred Store" description="Somashiva Sanctum privacy and data reverence principles.">
  <div class="max-w-4xl mx-auto px-6 py-16 text-[#f3e5ab]">
    <div class="bg-[#0c0a09] border border-[#d4af37]/60 rounded-3xl p-8 sm:p-12 shadow-2xl space-y-8">
      <div class="border-b border-[#d4af37]/40 pb-6">
        <span class="text-xs font-semibold text-[#d4af37] uppercase tracking-widest">Somashiva Sanctum</span>
        <h1 class="text-3xl sm:text-5xl font-bold font-['Cormorant_Garamond',serif] text-[#d4af37] mt-2 mb-2">Privacy & Data Reverence</h1>
        <p class="text-xs text-[#ebd9b8]/80 font-light">Last Updated: November 2026</p>
      </div>

      <div class="space-y-6 text-sm sm:text-base font-light leading-relaxed text-[#ebd9b8]">
        <div class="bg-black/40 border border-[#d4af37]/40 p-6 rounded-2xl">
          <h2 class="font-['Cormorant_Garamond',serif] text-xl font-bold text-[#d4af37] mb-2">Core Principle</h2>
          <p>
            "At Somashiva, we treat your personal coordinates with sacred trust. We strictly do not sell, rent, monetize, or disclose customer data to third-party ad brokers or marketing syndicates."
          </p>
        </div>

        <div class="space-y-4">
          <h2 class="font-['Cormorant_Garamond',serif] text-2xl font-bold text-[#d4af37]">What Data We Collect & Why</h2>
          
          <div class="space-y-3">
            <h3 class="font-semibold text-[#d4af37]">1. Shipping Address & Contact Details</h3>
            <p class="text-xs sm:text-sm text-[#ebd9b8]/90">
              Your name, delivery address, pincode, and phone number are collected solely for shipping manifests, Resend transactional receipts, AWB courier tracking via WhatsApp, and verifying unboxing videos for damage claims—never sold, rented, or shared with advertisers.
            </p>
          </div>

          <div class="space-y-3">
            <h3 class="font-semibold text-[#d4af37]">2. Email Communications</h3>
            <p class="text-xs sm:text-sm text-[#ebd9b8]/90">
              Used solely to dispatch itemized order receipts, purchase confirmations, and critical fulfillment notifications.
            </p>
          </div>

          <div class="space-y-3">
            <h3 class="font-semibold text-[#d4af37]">3. WhatsApp Communications</h3>
            <p class="text-xs sm:text-sm text-[#ebd9b8]/90">
              Used exclusively to transmit your Airway Bill (AWB) number, live transit tracking updates, and direct one-on-one customer support.
            </p>
          </div>

          <div class="space-y-3">
            <h3 class="font-semibold text-[#d4af37]">4. Verification Media</h3>
            <p class="text-xs sm:text-sm text-[#ebd9b8]/90">
              Unboxing videos and photographic records submitted for transit damage or manufacturing defects are reviewed privately and strictly to authorize replacements.
            </p>
          </div>
        </div>

        <div class="space-y-3">
          <h2 class="font-['Cormorant_Garamond',serif] text-2xl font-bold text-[#d4af37]">Third-Party Service Providers</h2>
          <p class="text-xs sm:text-sm text-[#ebd9b8]/90">
            We share data only with essential infrastructure partners strictly required to operate the service: our transactional email engine (Resend) and verified national courier logistics partners for package delivery.
          </p>
        </div>

        <div class="space-y-3">
          <h2 class="font-['Cormorant_Garamond',serif] text-2xl font-bold text-[#d4af37]">Data Retention & Deletion</h2>
          <p class="text-xs sm:text-sm text-[#ebd9b8]/90">
            You may request complete removal or correction of your contact details from our records at any time by contacting somashivaofficial@gmail.com or messaging our WhatsApp concierge at +91 9180603108.
          </p>
        </div>
      </div>

      <div class="pt-6 border-t border-[#d4af37]/40 text-center">
        <a href="/" class="inline-block bg-[#d4af37] hover:bg-[#b8860b] text-[#0c0a09] font-semibold py-3 px-8 rounded-2xl text-xs uppercase tracking-wider transition shadow-lg">
          Return to Sacred Store
        </a>
      </div>
    </div>
  </div>
</Layout>
