---
import Layout from '../layouts/Layout.astro';
---

<Layout title="B2B & Bulk Inquiries">
  <div class="max-w-xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-extrabold text-gray-900 text-center">Wholesale & Custom Orders</h1>
    <p class="text-gray-600 text-center mt-2 text-sm">Get custom pricing for retail orders or custom manufacturing.</p>

    <form action="https://formspree.io/f/YOUR_FORMSPREE_ID" method="POST" class="mt-8 space-y-4 bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
      <div>
        <label class="block text-sm font-medium text-gray-700">Business / Contact Name</label>
        <input type="text" name="company_name" required class="mt-1 w-full rounded-lg border-gray-300 border p-2.5 text-sm" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Phone / WhatsApp</label>
        <input type="tel" name="phone" required class="mt-1 w-full rounded-lg border-gray-300 border p-2.5 text-sm" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Required Quantity & Details</label>
        <textarea name="details" rows="4" required class="mt-1 w-full rounded-lg border-gray-300 border p-2.5 text-sm"></textarea>
      </div>
      <button type="submit" class="w-full bg-indigo-600 text-white font-medium py-3 rounded-lg hover:bg-indigo-700 transition text-sm">
        Request Quotation
      </button>
    </form>
  </div>
</Layout>
