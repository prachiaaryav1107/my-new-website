---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Warranty Registration">
  <div class="max-w-xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-extrabold text-gray-900 text-center">Register Product Warranty</h1>
    <p class="text-gray-600 text-center mt-2 text-sm">Submit your Amazon Order ID to activate lifetime support.</p>

    <form action="https://formspree.io/f/YOUR_FORMSPREE_ID" method="POST" class="mt-8 space-y-4 bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
      <div>
        <label class="block text-sm font-medium text-gray-700">Full Name</label>
        <input type="text" name="name" required class="mt-1 w-full rounded-lg border-gray-300 border p-2.5 text-sm" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Email Address</label>
        <input type="email" name="email" required class="mt-1 w-full rounded-lg border-gray-300 border p-2.5 text-sm" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Amazon Order ID</label>
        <input type="text" name="order_id" placeholder="e.g. 408-1234567-8901234" required class="mt-1 w-full rounded-lg border-gray-300 border p-2.5 text-sm" />
      </div>
      <button type="submit" class="w-full bg-indigo-600 text-white font-medium py-3 rounded-lg hover:bg-indigo-700 transition text-sm">
        Activate Warranty
      </button>
    </form>
  </div>
</Layout>
